rules_version = '2';
// Firebase 콘솔 -> Firestore Database -> Rules 탭에 이 내용을 붙여넣고 "게시"하세요.
// 각 사용자는 자기 uid 아래 문서만 읽고 쓸 수 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/patterns/{patternId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
